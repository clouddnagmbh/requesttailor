{
  "realm": "requesttailor",
  "displayName": "RequestTailor test realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 10,
  "accessTokenLifespanForImplicitFlow": 10,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rt-client-credentials",
      "name": "Client credentials",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rt-client-credentials-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      }
    },
    {
      "clientId": "rt-password",
      "name": "Resource owner password credentials",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rt-password-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "rt-auth-code",
      "name": "Authorization code with PKCE (public client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://127.0.0.1:47901/callback",
        "http://127.0.0.1:47902/callback",
        "http://127.0.0.1:8765/callback",
        "http://localhost:5173/oauth-callback.html",
        "http://127.0.0.1:5173/oauth-callback.html",
        "http://127.0.0.1:5185/oauth-callback.html"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "rt-auth-code-s256",
      "name": "Authorization code, PKCE S256 enforced (public client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "redirectUris": ["http://127.0.0.1:47901/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "rt-device",
      "name": "Device authorization grant (public client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "webOrigins": ["+"],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      }
    }
  ]
}
