{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000000001",
    "name": "Lossless",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Notes",
      "item": [
        {
          "name": "List notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/notes?q=milk",
              "host": ["{{baseUrl}}"],
              "path": ["notes"],
              "query": [{ "key": "q", "value": "milk" }]
            }
          }
        },
        {
          "name": "Add note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"text\": \"Buy milk\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/notes"
          }
        }
      ]
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "https://notes.example.com" }]
}
