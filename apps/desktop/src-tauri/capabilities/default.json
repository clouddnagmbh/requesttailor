{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own commands and nothing else: no file system, shell, dialog or other plugin APIs (the folder picker runs on the Rust side).",
  "windows": ["main"],
  "permissions": [
    "allow-open-collection",
    "allow-tree",
    "allow-get-request",
    "allow-create-request",
    "allow-update-request",
    "allow-dirty",
    "allow-save",
    "allow-environments",
    "allow-update-environment",
    "allow-delete-environment",
    "allow-preview",
    "allow-send",
    "allow-response-lines",
    "allow-response-bytes",
    "allow-filter-json",
    "allow-release-response",
    "allow-secret-has",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-commit",
    "allow-git-log",
    "allow-git-branches",
    "allow-git-checkout",
    "allow-git-create-branch",
    "allow-git-push",
    "allow-git-pull",
    "allow-git-conflict",
    "allow-git-resolve",
    "allow-git-init",
    "allow-git-clone",
    "allow-git-identity",
    "allow-git-set-identity",
    "allow-git-has-credentials",
    "allow-git-set-credentials",
    "allow-git-delete-credentials",
    "allow-import-analyze",
    "allow-import-write",
    "allow-import-discard",
    "allow-history-list",
    "allow-history-clear",
    "allow-search",
    "allow-recent-collections",
    "allow-open-recent"
  ]
}
