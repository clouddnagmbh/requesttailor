{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own commands and listen to the app's events (OAuth 2.0 prompts), nothing else: no file system, shell, opener, dialog or other plugin APIs (the folder picker and the system browser run on the Rust side).",
  "windows": ["main"],
  "permissions": [
    "allow-open-collection",
    "allow-tree",
    "allow-get-request",
    "allow-create-request",
    "allow-create-folder",
    "allow-update-request",
    "allow-dirty",
    "allow-save",
    "allow-environments",
    "allow-update-environment",
    "allow-delete-environment",
    "allow-preview",
    "allow-send",
    "allow-response-lines",
    "allow-response-bytes",
    "allow-filter-json",
    "allow-release-response",
    "allow-secret-has",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-commit",
    "allow-git-log",
    "allow-git-branches",
    "allow-git-checkout",
    "allow-git-create-branch",
    "allow-git-push",
    "allow-git-pull",
    "allow-git-conflict",
    "allow-git-resolve",
    "allow-git-init",
    "allow-git-clone",
    "allow-git-identity",
    "allow-git-set-identity",
    "allow-git-has-credentials",
    "allow-git-set-credentials",
    "allow-git-delete-credentials",
    "allow-import-analyze",
    "allow-import-write",
    "allow-import-discard",
    "allow-history-list",
    "allow-history-clear",
    "allow-search",
    "allow-recent-collections",
    "allow-open-recent",
    "allow-git-scan",
    "allow-import-analyze-plugin",
    "allow-plugin-list",
    "allow-plugin-inspect",
    "allow-plugin-install",
    "allow-plugin-remove",
    "allow-plugin-set-enabled",
    "allow-plugin-render-tab",
    "allow-plugin-action",
    "allow-plugin-welcome",
    "allow-plugin-choose-welcome",
    "allow-auth-tokens",
    "allow-auth-fetch-token",
    "allow-auth-clear-tokens",
    "allow-auth-cancel-prompt",
    "allow-cookie-list",
    "allow-cookie-delete",
    "allow-cookie-clear",
    "allow-scripts-trust",
    "allow-scripts-set-trusted",
    "allow-scripts-session-vars",
    "allow-scripts-set-session-var",
    "allow-scripts-clear-session-vars",
    "allow-runner-plan",
    "allow-runner-parse-data",
    "allow-runner-run",
    "allow-runner-cancel",
    "allow-ai-config",
    "allow-ai-set-config",
    "allow-ai-has-key",
    "allow-ai-set-key",
    "allow-ai-delete-key",
    "allow-ai-ask",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
