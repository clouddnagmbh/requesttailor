{
  "name": "@requesttailor/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tauri 2 desktop shell.",
  "type": "module",
  "exports": {
    "./backend": "./src/backend.ts"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run bundle-plugins && tauri build --no-bundle",
    "bundle-plugins": "node ../../scripts/build-plugins.mjs --optional --out src-tauri/bundled-plugins odata",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:frontend": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@requesttailor/ui": "0.0.0",
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
