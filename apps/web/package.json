{
  "name": "@requesttailor/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Web app (core as WebAssembly).",
  "type": "module",
  "exports": {
    "./backend": "./src/web-backend.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/build-wasm.mjs --optional && vite",
    "build": "node ../../scripts/build-wasm.mjs && vite build && npm run bundle-plugins",
    "bundle-plugins": "node ../../scripts/build-plugins.mjs --optional --out dist/plugins odata",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test && npm run e2e:shells",
    "e2e:shells": "node ../../scripts/build-wasm.mjs && playwright test --config e2e/shells/playwright.config.ts && playwright test --config e2e/import/playwright.import.config.ts && playwright test --config e2e/compare/playwright.real.config.ts && playwright test --config e2e/review/playwright.real.config.ts",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@requesttailor/ui": "0.0.0",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.44.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
