<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic test data written for RequestTailor (Apache-2.0). Not taken from any vendor. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:requesttailor:test:types"
           targetNamespace="urn:requesttailor:test:types"
           elementFormDefault="qualified">
  <xs:simpleType name="Currency">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EUR"/>
      <xs:enumeration value="USD"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Money">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="t:Currency" use="required"/>
        <xs:attribute name="note" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Address">
    <xs:sequence>
      <xs:element name="street" type="xs:string"/>
      <xs:element name="city" type="xs:string"/>
      <xs:element name="country" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Node">
    <xs:sequence>
      <xs:element name="label" type="xs:string"/>
      <xs:element name="child" type="t:Node" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
