    "url": "https://api.example.com:8443/v1/items?id=5&all#top",
    "headers": [
      [
        "X-A",
        "1"
      ]
    ],
    "body": null
  },
  "response": {
    "status": 200,
    "headers": [
      [
        "Content-Type",
        "application/json"
      ]
    ],
    "body": "{}",
    "time_ms": 12,
    "url": "http://h/x"
  },
  "expect": {
    "logs": [
      {
        "level": "log",
        "text": "https://api.example.com:8443/v1/items?id=5&all#top https api.example.com 8443 /v1/items v1|items id=5&all 5 top"
      },
      {
        "level": "log",
        "text": "DELETE 1 {\"X-A\":\"1\"}"
      }
    ],
    "error": null
  }
