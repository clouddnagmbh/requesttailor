{
  "name": "pm: pm.request.url parts and pm.request in tests",
  "phase": "tests",
  "scripts": [
    {
      "origin": "request",
      "code": "const u = pm.request.url;\nconsole.log(u.toString(), u.protocol, u.getHost(), u.port, u.getPath(), u.path.join(\"|\"), u.getQueryString(), u.query.get(\"id\"), u.hash);\nconsole.log(pm.request.method, pm.request.headers.get(\"x-a\"), JSON.stringify(pm.request.getHeaders()));"
    }
  ],
  "request": {
