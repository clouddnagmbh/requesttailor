{
  "name": "throwing a non-Error value reports the value",
  "phase": "before-request",
  "scripts": [
    {
      "origin": "request",
      "code": "throw 'boom';"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "expect": {
    "error": "boom"
  }
}
