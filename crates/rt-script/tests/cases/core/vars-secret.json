{
  "name": "scripts see secret values (the core masks what leaves the script)",
  "phase": "before-request",
  "scripts": [
    {
      "origin": "request",
      "code": "console.log('key=' + rt.vars.get('apiKey'));"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "variables": [
    {
      "name": "apiKey",
      "value": "s3cr3t-value",
      "source": {
        "layer": "environment",
        "name": "Local"
      },
      "secret": true
    }
  ],
  "expect": {
    "logs": [
      {
        "level": "log",
        "text": "key=s3cr3t-value"
      }
    ]
  }
}
