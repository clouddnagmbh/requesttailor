{
  "name": "deep recursion is a RangeError, not a crash",
  "phase": "before-request",
  "scripts": [
    {
      "origin": "request",
      "code": "function f(n) { return f(n + 1) + 1; }\nf(0);"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "expect": {
    "error": "RangeError: Maximum call stack size exceeded"
  }
}
