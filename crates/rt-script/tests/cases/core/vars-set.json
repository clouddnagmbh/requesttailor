        "scope": "collection"
      },
      {
        "name": "flag",
        "value": "true",
        "scope": "global"
      },
      {
        "name": "nothing",
        "value": "undefined",
        "scope": "runtime"
      },
      {
        "name": "base",
        "value": "http://changed",
        "scope": "environment"
      }
    ],
    "logs": [
