{
  "name": "after the send rt.request.headers cannot be changed",
  "phase": "after-response",
  "scripts": [
    {
      "origin": "request",
      "code": "rt.request.headers.set('X', '1');"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "response": {
    "status": 200,
    "headers": [
      [
        "Content-Type",
        "application/json"
      ],
      [
        "X-Id",
        "1"
      ],
      [
        "x-id",
        "2"
      ]
    ],
    "body": "{\"id\":7,\"items\":[1,2]}",
    "time_ms": 12,
    "url": "http://h/x"
  },
  "expect": {
    "error": "read-only"
  }
}
