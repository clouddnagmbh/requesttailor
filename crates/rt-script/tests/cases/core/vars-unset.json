{
  "name": "rt.vars.unset removes the variable from that scope; lower layers show again",
  "phase": "after-response",
  "scripts": [
    {
      "origin": "request",
      "code": "rt.vars.unset('id');\nconsole.log(rt.vars.get('id'), rt.vars.has('id'));\nrt.vars.unset('base', 'environment');\nconsole.log(rt.vars.get('base'));"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "response": {
    "status": 200,
    "headers": [
      [
        "Content-Type",
        "application/json"
      ],
      [
        "X-Id",
        "1"
      ],
      [
        "x-id",
        "2"
      ]
    ],
    "body": "{\"id\":7,\"items\":[1,2]}",
    "time_ms": 12,
    "url": "http://h/x"
  },
  "variables": [
    {
      "name": "base",
      "value": "http://global",
      "source": {
        "layer": "global"
      },
      "secret": false
    },
    {
      "name": "only",
      "value": "g",
      "source": {
        "layer": "global"
      },
      "secret": false
    },
    {
      "name": "base",
