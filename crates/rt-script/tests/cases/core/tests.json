{
  "name": "test(): passed, failed with the error's message, other errors keep their name",
  "phase": "tests",
  "scripts": [
    {
      "origin": "request",
      "code": "test('status is 200', () => { if (rt.response.status !== 200) throw new Error('bad'); });\ntest('fails', () => { throw new Error('expected 1 to equal 2'); });\ntest('type error', () => { null.x; });\ntest('thrown string', () => { throw 'plain'; });"
    }
  ],
  "request": {
    "method": "GET",
    "url": "http://h/x",
    "headers": [
      [
        "Accept",
        "application/json"
      ]
    ],
    "body": null
  },
  "response": {
    "status": 200,
    "headers": [
      [
        "Content-Type",
        "application/json"
      ],
      [
        "X-Id",
        "1"
      ],
      [
        "x-id",
        "2"
      ]
    ],
    "body": "{\"id\":7,\"items\":[1,2]}",
    "time_ms": 12,
    "url": "http://h/x"
  },
  "expect": {
    "tests": [
      {
        "name": "status is 200",
        "passed": true
      },
      {
